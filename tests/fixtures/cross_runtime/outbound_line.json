{
  "algorithm": "outbound_line",
  "cases": [
    {"id": "empty", "input": "", "expected": ""},
    {"id": "mention", "input": "Please ask @leehopper.", "expected": "Please ask ＠leehopper."},
    {"id": "email", "input": "Contact dev@example.com for details.", "expected": "Contact dev@example.com for details."},
    {"id": "html", "input": "<dev@example.com>", "expected": "&lt;dev@example.com>"},
    {"id": "link_destination", "input": "[profile](https://x.test/@user)", "expected": "[profile](https://x.test/＠user)"},
    {"id": "inline_code", "input": "code `@inside <tag> &copy;` and @outside", "expected": "code `＠inside ＜tag> &copy;` and ＠outside"},
    {"id": "unclosed_code", "input": "open `@outside <tag>", "expected": "open \\`＠outside &lt;tag>"},
    {"id": "unequal_delimiter", "input": "`a`` @inside", "expected": "\\`a\\`\\` ＠inside"},
    {"id": "named_reference", "input": "&amp; &#64; &#60;table", "expected": "&amp; ＠ &lt;table"}
  ]
}
