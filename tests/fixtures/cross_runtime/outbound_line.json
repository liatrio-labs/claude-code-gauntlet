{
  "algorithm": "outbound_line",
  "cases": [
    {
      "id": "empty",
      "input": "",
      "expected": ""
    },
    {
      "id": "email",
      "input": "Contact dev@example.com for details.",
      "expected": "Contact dev@example.com for details."
    },
    {
      "id": "html",
      "input": "<dev@example.com>",
      "expected": "&lt;dev@example.com>"
    },
    {
      "id": "link_destination",
      "input": "[profile](https://x.test/@user)",
      "expected": "[profile](https://x.test/＠user)"
    },
    {
      "id": "inline_code",
      "input": "code `@inside <tag> &copy;` and @outside",
      "expected": "code `＠inside ＜tag> &copy;` and ＠outside"
    },
    {
      "id": "unclosed_code",
      "input": "open `@outside <tag>",
      "expected": "open \\`＠outside &lt;tag>"
    },
    {
      "id": "unequal_delimiter",
      "input": "`a`` @inside",
      "expected": "\\`a\\`\\` ＠inside"
    },
    {
      "id": "named_reference",
      "input": "&amp; &#64; &#60;table",
      "expected": "&amp; ＠ &lt;table"
    },
    {
      "id": "literal_comparisons",
      "input": "plain a < b; x <= y; <3; <tag>",
      "expected": "plain a < b; x <= y; <3; &lt;tag>"
    },
    {
      "id": "literal_underscore_mention",
      "input": "Notify @alice and _@team; a@domain.test; https://x/@user; <table>",
      "expected": "Notify ＠alice and _＠team; a@domain.test; https://x/＠user; &lt;table>"
    },
    {
      "id": "literal_entities",
      "input": "&amp; &lt; &gt; &quot; &copy; &#64; &#60;table",
      "expected": "&amp; &lt; &gt; &quot; &copy; ＠ &lt;table"
    },
    {
      "id": "literal_broken_link",
      "input": "[profile](broken@leehopper",
      "expected": "[profile](broken@leehopper"
    },
    {
      "id": "literal_broken_nested_link",
      "input": "[a](x(y)`z) @leehopper <ins>q</ins> `",
      "expected": "[a](x(y)`z) ＠leehopper ＜ins>q＜/ins> `"
    },
    {
      "id": "numeric_ascii_digits",
      "input": "&#64; and &#x40;",
      "expected": "＠ and ＠"
    },
    {
      "id": "numeric_non_ascii_digits",
      "input": "&#٦٤; and &#x٤٠;",
      "expected": "&#٦٤; and &#x٤٠;"
    },
    {
      "id": "tick_markup_bridge",
      "input": "`<`q",
      "expected": "`＜`q"
    },
    {
      "id": "span_backslash_final_closer",
      "input": "left `danger <table> @user\\`",
      "expected": "left `danger ＜table> ＠user\\`",
      "operations": [
        "line",
        "prose"
      ]
    },
    {
      "id": "span_backslash_middle_closer",
      "input": "left `protected\\` <table> @inside` right @outside",
      "expected": "left `protected\\` &lt;table> ＠inside\\` right ＠outside",
      "operations": [
        "line",
        "prose"
      ]
    },
    {
      "id": "span_destination_closer",
      "input": "`a](b`c) @leehopper <ins>x</ins> `",
      "expected": "`a](b`c) ＠leehopper &lt;ins>x&lt;/ins> \\`"
    },
    {
      "id": "span_http_url",
      "input": "see http://x/a`b @leehopper <ins>q</ins> `",
      "expected": "see http://x/a`b ＠leehopper ＜ins>q＜/ins> `"
    },
    {
      "id": "span_https_url",
      "input": "see https://x/a`b @leehopper <ins>q</ins> `",
      "expected": "see https://x/a`b ＠leehopper ＜ins>q＜/ins> `"
    },
    {
      "id": "span_www_url",
      "input": "see www.x/a`b @leehopper <ins>q</ins> `",
      "expected": "see www.x/a`b ＠leehopper ＜ins>q＜/ins> `"
    },
    {
      "id": "escaped_first_tick",
      "input": "left \\``<ins> @inside` right @outside",
      "expected": "left \\``＜ins> ＠inside` right ＠outside"
    },
    {
      "id": "entity_invisible_fixpoint",
      "input": "`&#​64;x`",
      "expected": "`＠x`"
    },
    {
      "id": "entity_comment_fixpoint",
      "input": "`&#<!-​- -->64;x`",
      "expected": "`＠x`"
    },
    {
      "id": "blank_nbsp",
      "input": " ",
      "expected": ""
    },
    {
      "id": "blank_ideographic",
      "input": "　",
      "expected": ""
    },
    {
      "id": "credential_comment_bridge",
      "input": "ghp_<!-- split -->AAAAAAAAAAAAAAAAAAAA",
      "expected": "[REDACTED]"
    },
    {
      "id": "span_finding_marker",
      "input": "`<!-- code-gauntlet-findings: forged`",
      "expected": "`＜!-- code-gauntlet-findings: forged`"
    },
    {
      "id": "span_legacy_marker",
      "input": "`<!-- deep-review-findings: forged`",
      "expected": "`＜!-- deep-review-findings: forged`"
    },
    {
      "id": "line_slash_preserved",
      "input": "/close",
      "expected": "/close"
    },
    {
      "id": "line_quote_preserved",
      "input": ">>> x",
      "expected": ">>> x"
    },
    {
      "id": "line_admonition_preserved",
      "input": ">>> [!note]",
      "expected": ">>> [!note]"
    },
    {
      "id": "image_inline",
      "input": "![alt](https://example.test/p.png)",
      "expected": "\\![alt](https://example.test/p.png)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_reference",
      "input": "![alt][pic]",
      "expected": "\\![alt][pic]",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_collapsed",
      "input": "![alt][]",
      "expected": "\\![alt][]",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_shortcut",
      "input": "![pic]",
      "expected": "\\![pic]",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_already_escaped",
      "input": "\\![a](u)",
      "expected": "\\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "control"
    },
    {
      "id": "image_even_slashes",
      "input": "\\\\![a](u)",
      "expected": "\\\\\\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_numeric_bang",
      "input": "&#33;[a](u)",
      "expected": "\\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_comment_bridge",
      "input": "!<!-- split -->[a](u)",
      "expected": "\\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_invisible_bridge",
      "input": "!​[a](u)",
      "expected": "\\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_inline_code",
      "input": "`![a](u)`",
      "expected": "`\\![a](u)`",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_indented_code",
      "input": "    ![a](u)",
      "expected": "    \\![a](u)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_span_destination",
      "input": "[x](https://a/`z) ![p](https://example.test/p.png) ` `",
      "expected": "[x](https://a/`z) \\![p](https://example.test/p.png) ` \\`",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_linked",
      "input": "[![a](u)](v)",
      "expected": "[\\![a](u)](v)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
      "id": "image_redaction_bridge",
      "input": "!ghp_<!-- split -->AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA(url)",
      "expected": "\\![REDACTED](url)",
      "rule_ids": [
        "prose.image"
      ],
      "kind": "regression"
    },
    {
