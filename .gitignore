# Eval workspace outputs (deep-review-workspace/ retained for pre-rename local dirs)
deep-review-workspace/
*-workspace/

# Review output files (deep-review-* entries retained for pre-rename local files)
code-gauntlet-*.md
deep-review-*.md

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# Python cache
__pycache__/
*.pyc

# Claude Code local settings. `.claude/rules/` is shipped — it is the path-scoped half of
# the agent instructions and contributors need it. Ignore the directory's contents, then
# re-include that one subtree (git will not descend into a wholly-ignored directory, so
# `.claude/*` rather than `.claude/` is required for the negation to be reachable).
.claude/*
!.claude/rules/

# Internal development artifacts (not shipped)
docs/specs/
docs/temp/
docs/design/
docs/superpowers/
docs/improvement-backlog.md
/.code-gauntlet/
# pre-rename output dir, retained for local files
/.deep-review/
bench/workspace/
bench/.env
probes/

# Agentic SDD scratch (plans/briefs/reviews)
.superpowers/
